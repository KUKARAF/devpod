# shellcheck shell=bash
alias gr="git rev-parse --show-toplevel"

# Git
alias gs="git status -sb"
alias gl="git log --oneline --graph --decorate -20"
alias gd="git diff"
alias gco="git checkout"
alias gc="git commit"
alias gp="git push"

# Navigation
alias ..="cd .."
alias ...="cd ../.."

# Enhanced tools (only when available via nix)
command -v eza   &>/dev/null && alias ll="eza -lah --icons --git"
command -v eza   &>/dev/null && alias ls="eza --icons"
command -v eza   &>/dev/null && alias tree="eza --tree --icons"
command -v bat   &>/dev/null && alias cat="bat --paging=never"
command -v delta &>/dev/null && alias diff="delta"

# Safety
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"

# work
alias zj='zellij attach "$(basename $(dirname $PWD))-$(basename $PWD)" 2>/dev/null || zellij --session "$(basename $(dirname $PWD))-$(basename $PWD)"'

# Self-hosted LiteLLM proxy (not a secret; the key comes from kv below)
export LITELLM_PROXY_API_BASE=https://litellm.osmosis.page

# kv secrets — loaded from a tmpfs cache so shell startup never waits on kv; refreshed in the background
_kv_keys=(
    ANTHROPIC_API_KEY
    OPENAI_API_KEY
    GEMINI_API_KEY
    CEREBRAS_API_KEY
    HF_TOKEN
    VERTEXAI_PROJECT
    VERTEXAI_LOCATION
    GROQ_API_KEY
    AWS_ACCESS_KEY_ID
    AWS_SECRET_ACCESS_KEY
    AWS_REGION
    AWS_PROFILE
    AWS_BEARER_TOKEN_BEDROCK
    AZURE_OPENAI_API_ENDPOINT
    AZURE_OPENAI_API_VERSION
    JINA_API_KEY
    LITELLM_API_TOKEN
    LITELLM_PROXY_API_KEY
)
_kv_cache="${XDG_RUNTIME_DIR:+$XDG_RUNTIME_DIR/kv-env}"

# print `export` lines for every key, fetching them in parallel
_kv_dump_env() {
    local tmp key
    tmp="$(mktemp -d)" || return 1
    for key in "${_kv_keys[@]}"; do
        {
            local val
            val="$(kv get "$key" </dev/null 2>/dev/null)" && [[ -n "$val" ]] && printf 'export %s=%q\n' "$key" "$val" >"$tmp/$key"
        } &
    done
    wait
    cat "$tmp"/* 2>/dev/null
    rm -rf "$tmp"
}

_kv_post() {
    # aider reads AIDER_* env vars as its options; this keeps the LiteLLM token out of generic OPENAI_API_KEY
    [[ -n "${LITELLM_API_TOKEN:-}" ]] && export AIDER_OPENAI_API_KEY="$LITELLM_API_TOKEN"
    # pi's models.json reads $LITELLM_API_KEY; aider reads LITELLM_PROXY_API_KEY.
    [[ -n "${LITELLM_PROXY_API_KEY:-}" ]] && export LITELLM_API_KEY="$LITELLM_PROXY_API_KEY"
}

_kv_load_env() {
    eval "$(_kv_dump_env)"
    _kv_post
}

# write the cache atomically (0600); silent, no job-control noise
_kv_refresh_cache() {
    (
        umask 077
        kv session check 2>/dev/null || exit 0
        _kv_dump_env >"$_kv_cache.$$"
        # never replace a good cache with an empty one
        [[ -s "$_kv_cache.$$" ]] && mv -f "$_kv_cache.$$" "$_kv_cache"
        rm -f "$_kv_cache.$$"
    ) &>/dev/null &
    disown 2>/dev/null
}

# picks up the cache at the next prompt when it wasn't ready at startup, then turns itself off
_kv_pickup() {
    [[ -s "$_kv_cache" ]] || return 0
    . "$_kv_cache"
    _kv_post
    _kv_pickup() { :; }
}

if command -v kv &>/dev/null; then
    if [[ -n "$_kv_cache" ]]; then
        if [[ -s "$_kv_cache" ]]; then
            . "$_kv_cache"
            _kv_post
        elif [[ $- == *i* ]]; then
            PROMPT_COMMAND="_kv_pickup${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        fi
        if [[ ! -s "$_kv_cache" || -n "$(find "$_kv_cache" -mmin +10 2>/dev/null)" ]]; then
            _kv_refresh_cache
        fi
    elif kv session check 2>/dev/null; then
        _kv_load_env
    fi
fi

load_env() {
    if ! command -v kv &>/dev/null; then
        echo "kv: command not found" >&2
        return 1
    fi
    if ! kv session check 2>/dev/null; then
        kv session request || return 1
    fi
    _kv_load_env
    [[ -n "$_kv_cache" ]] && _kv_refresh_cache
    echo "env loaded"
}

# pi: only expose LiteLLM models (other providers show up whenever their API key is in the env)
alias pi='env -u GROQ_API_KEY -u GEMINI_API_KEY -u CEREBRAS_API_KEY pi'
