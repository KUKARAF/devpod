#!/usr/bin/env bash
# Usage: devenv
# If the nix-toolbox container exists, enter it. Otherwise, set it up first.
set -euo pipefail

# Follow the host's Fedora release. Hardcoding it means a rebase to a newer
# image leaves the toolbox a release behind, which is what broke Mesa/EGL.
OS_VERSION="$( . /etc/os-release && echo "$VERSION_ID" )"
TOOLBOX_NAME="nix-toolbox-${OS_VERSION}"
TOOLBOX_IMAGE="ghcr.io/thrix/nix-toolbox:${OS_VERSION}"
DOTFILES_REPO="https://github.com/KUKARAF/devpod.git"
DOTFILES_DIR="$HOME/.config/dotfiles"

if toolbox list --containers | grep -q "$TOOLBOX_NAME"; then
    exec toolbox enter "$TOOLBOX_NAME"
fi

echo "==> Cloning dotfiles to host..."
if [ ! -d "$DOTFILES_DIR" ]; then
    git clone "$DOTFILES_REPO" "$DOTFILES_DIR"
else
    git -C "$DOTFILES_DIR" pull --ff-only || true
fi
echo "==> Stowing dotfiles on host..."
stow -t ~ --adopt -d "$DOTFILES_DIR" .

echo "==> Creating toolbox '$TOOLBOX_NAME'..."
toolbox create --image "$TOOLBOX_IMAGE" "$TOOLBOX_NAME"

# zellij lives in the host image, not in nix. It is a static musl binary, so
# the host copy runs unmodified inside the container -- toolbox bind-mounts the
# host root at /run/host, but does not put it on PATH. Symlink just this one
# tool rather than exposing all of /run/host/usr/bin, which would shadow the
# container's own binaries.
echo "==> Linking host zellij into '$TOOLBOX_NAME'..."
toolbox run --container "$TOOLBOX_NAME" sudo ln -sf /run/host/usr/bin/zellij /usr/local/bin/zellij

echo "==> Running nix-toolbox setup inside '$TOOLBOX_NAME'..."
# -l: the setup script needs home-manager, which only lands on PATH once
# /etc/profile.d/nix.sh has been sourced by a login shell.
toolbox run --container "$TOOLBOX_NAME" bash -l "$DOTFILES_DIR/.tools/nix-toolbox-setup.sh"

echo "==> Installing uv tools..."
bash "$DOTFILES_DIR/.tools/install-uv-tools.sh"

echo "==> Done! Run 'devenv' again to enter the toolbox."
