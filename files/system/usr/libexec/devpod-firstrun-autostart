#!/usr/bin/env bash
# Launched once per user by /etc/xdg/autostart/devpod-firstrun.desktop.
# Opens the app picker in a terminal on first login, then never again.
# devpod-apps stays available manually afterwards.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devpod"
SENTINEL="$STATE_DIR/firstrun-done"

[ -e "$SENTINEL" ] && exit 0

# Write the sentinel up front: if the picker crashes or the window is closed,
# we must not re-prompt on every login.
mkdir -p "$STATE_DIR"
date -Is > "$SENTINEL"

exec ghostty -e /usr/bin/devpod-apps
