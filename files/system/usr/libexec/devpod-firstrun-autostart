#!/usr/bin/env bash
# Launched once per user by /etc/xdg/autostart/devpod-firstrun.desktop.
# Opens the setup menu in a terminal on first login, then never again.
# 'devpod' stays available manually afterwards.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devpod"
SENTINEL="$STATE_DIR/firstrun-done"

[ -e "$SENTINEL" ] && exit 0

# Nothing to offer (e.g. everything is already installed)? Don't flash a
# terminal, and don't burn the one-shot: leave the sentinel unwritten so a
# later image with new apps in the catalogue can still prompt once.
/usr/bin/devpod --check || exit 0

# Write the sentinel up front: if the picker crashes or the window is closed,
# we must not re-prompt on every login.
mkdir -p "$STATE_DIR"
date -Is > "$SENTINEL"

exec ghostty -e /usr/bin/devpod
